# Copy to config.env (gitignored) and fill in your values.

# --- Repository ---
REPO_ROOT=/absolute/path/to/your-repo
GIT_BASE_BRANCH=develop
# Application code directory relative to repo root
# Flutter: lib | Laravel/PHP: app | Node: src
CODE_PATH=lib
# flutter | laravel | generic — adjusts agent prompt patterns
PROJECT_PROFILE=flutter

# --- Sentry ---
SENTRY_ORG_SLUG=your-org-slug
SENTRY_PROJECT_SLUG=your-project-slug
SENTRY_REGION_URL=https://us.sentry.io
SENTRY_QUERY="is:unresolved level:error"
SENTRY_PAGE_SIZE=100
SENTRY_MAX_PAGES=10
SENTRY_TRIAGE_SIMPLE_FIRST=true
# Recommended — enables REST pagination (org:read, project:read, event:read)
SENTRY_AUTH_TOKEN=""

# --- Bitbucket PR ---
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=your-repo-slug
BITBUCKET_AUTH=bearer
BITBUCKET_ACCESS_TOKEN=""
# BITBUCKET_AUTH=basic
# BITBUCKET_EMAIL=you@company.com
BITBUCKET_PR_REVIEWERS=your-username

# --- Cursor CLI ---
CURSOR_BIN=/Users/you/.local/bin/cursor
CURSOR_AGENT_MODEL=composer-2.5

# --- Runtime ---
POLL_SECONDS=300
AUTO_INSTALL_LAUNCHAGENT=true
PR_DRAFT=true
CLOSE_SOURCE_BRANCH=true

# --- Quality gates (post-agent, before PR) ---
REQUIRE_TESTS_TIER12=true
TEST_GATE_ENABLED=true
FIX_CONFIDENCE_MIN=medium
TEST_TIMEOUT_SECONDS=600
SYNC_PR_FEEDBACK_ON_RUN=true

# --- Slack notifications (Bot Token recommended; webhook optional fallback) ---
# Create app: https://api.slack.com/apps → From scratch
# OAuth scopes: chat:write, channels:read (reactions:read only if you need reactions)
# Install to workspace → copy Bot User OAuth Token (xoxb-...)
# Channel ID from link: .../archives/C0BGPF244H3 → invite bot with /invite @YourApp
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
# Optional alias used by some apps:
# SLACK_REVIEW_CHANNEL_ID=C0BGPF244H3
# Optional fallback if you cannot use a bot:
SLACK_WEBHOOK_URL=""
# Signing secret only needed for inbound Slack requests (slash commands) — not for status posts
# SLACK_SIGNING_SECRET=""
SLACK_NOTIFY_ENABLED=true
SLACK_NOTIFY_RUN_START=false
SLACK_NOTIFY_CODEGUARDIAN=true
SLACK_NOTIFY_PR_MERGED=true

# --- CodeGuardian AI (Flutter only — vendored under vendor/codeguardian/) ---
# ./setup.sh bootstraps Melos and sets these automatically.
CODEGUARDIAN_ENABLED=true
# Absolute path filled by setup.sh; relative default works after setup:
CODEGUARDIAN_CLI=
CODEGUARDIAN_MODE=validate
CODEGUARDIAN_TIMEOUT=600
CODEGUARDIAN_FAIL_BLOCKS_PR=true

# ---------------------------------------------------------------------------
# Laravel profile overrides (LARAVEL_ prefix)
# When ./run.sh is called with "laravel" as first arg, these values replace
# the base keys above for the duration of that run.
# ---------------------------------------------------------------------------
LARAVEL_REPO_ROOT=/absolute/path/to/laravel-api
LARAVEL_GIT_BASE_BRANCH=develop
LARAVEL_CODE_PATH=app
LARAVEL_SENTRY_ORG_SLUG=your-org-slug
LARAVEL_SENTRY_PROJECT_SLUG=your-laravel-project
LARAVEL_SENTRY_REGION_URL=https://us.sentry.io
LARAVEL_SENTRY_AUTH_TOKEN=""
LARAVEL_BITBUCKET_WORKSPACE=your-workspace
LARAVEL_BITBUCKET_REPO_SLUG=your-laravel-repo
LARAVEL_BITBUCKET_ACCESS_TOKEN=""
LARAVEL_BITBUCKET_PR_REVIEWERS=your-laravel-reviewer
