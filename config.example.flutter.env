# Example: Abyan Flutter mobile app (copy to config.env and fill secrets)

REPO_ROOT=/Users/you/abyan-app-flutter
GIT_BASE_BRANCH=sprint/sentry-auto-fix
CODE_PATH=lib
PROJECT_PROFILE=flutter

SENTRY_ORG_SLUG=abyan-capital-hu
SENTRY_PROJECT_SLUG=robo-staging
SENTRY_REGION_URL=https://us.sentry.io
SENTRY_QUERY="is:unresolved level:error"
SENTRY_AUTH_TOKEN=""

BITBUCKET_WORKSPACE=robo-adv
BITBUCKET_REPO_SLUG=abyan-app-flutter
BITBUCKET_AUTH=bearer
BITBUCKET_ACCESS_TOKEN=""
BITBUCKET_PR_REVIEWERS=MehsaraIrfan

CURSOR_BIN=/Users/you/.local/bin/cursor
POLL_SECONDS=300
