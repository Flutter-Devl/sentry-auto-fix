<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abyan.sentry-autofix</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mehsarairfan/abyan-app-flutter/scripts/sentry-auto-fix/run.sh</string>
    <string>daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mehsarairfan/abyan-app-flutter/scripts/sentry-auto-fix</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/mehsarairfan/abyan-app-flutter/scripts/sentry-auto-fix/logs/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mehsarairfan/abyan-app-flutter/scripts/sentry-auto-fix/logs/daemon.err</string>
</dict>
</plist>
